<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="sensor_rgb" params="name mount rate xyz:=${[0,0,0]} rpy:=${[0,0,0]}">
    <xacro:sensor_body name="${name}" mount="${mount}" dx="0.02" dz="0.04" off="${xyz}" rpy="${rpy}"/>
    <xacro:optical_frame name="${name}"/>
    <gazebo reference="${name}_link">
      <sensor name="${name}" type="camera">
        <gz_frame_id>${name}_link</gz_frame_id><topic>${name}/image</topic>
        <update_rate>${rate}</update_rate><always_on>true</always_on><visualize>false</visualize>
        <camera><horizontal_fov>1.2</horizontal_fov><image><width>640</width><height>480</height></image>
          <clip><near>0.1</near><far>50</far></clip>
          <optical_frame_id>${name}_optical_frame</optical_frame_id></camera>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
