<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Casters sit 2 mm above the wheel contact plane so they never unload the drive wheels. -->
  <xacro:macro name="caster" params="name x">
    <joint name="${name}_joint" type="fixed"><parent link="chassis"/><child link="${name}"/><origin xyz="${x} 0 ${0.052 - (wheel_r + 0.05)}"/></joint>
    <link name="${name}">
      <visual><geometry><sphere radius="0.05"/></geometry><material name="rb_caster"/></visual>
      <collision><geometry><sphere radius="0.05"/></geometry></collision>
      <inertial><mass value="0.1"/><inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <gazebo reference="${name}"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  </xacro:macro>
  <xacro:macro name="drive">
    <xacro:chassis/>
    <xacro:wheel prefix="left"  parent="chassis" x="0" y="${track/2}"  z="${-0.05}"><mu1>1.0</mu1></xacro:wheel>
    <xacro:wheel prefix="right" parent="chassis" x="0" y="${-track/2}" z="${-0.05}"><mu1>1.0</mu1></xacro:wheel>
    <xacro:caster name="caster_front" x="0.22"/>
    <xacro:caster name="caster_rear"  x="-0.22"/>
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
      <xacro:vel_joint name="left_wheel_joint"/><xacro:vel_joint name="right_wheel_joint"/>
    </ros2_control>
  </xacro:macro>
</robot>
